# Small async2 utilities shared across firmware modules.

load("@pigweed//pw_unit_test:pw_cc_test.bzl", "pw_cc_test")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//maco_firmware:__subpackages__"])

# Header-only: runs a Coro<pw::Status> as a task and reports a non-OK exit.
# Replaces pw_async2's removed CoroOrElseTask.
cc_library(
    name = "status_coro_task",
    hdrs = ["public/async_util/status_coro_task.h"],
    includes = ["public"],
    deps = [
        "@pigweed//pw_async2:coro",
        "@pigweed//pw_async2:poll",
        "@pigweed//pw_async2:pw_async2",
        "@pigweed//pw_function",
        "@pigweed//pw_status",
    ],
)

pw_cc_test(
    name = "status_coro_task_test",
    srcs = ["status_coro_task_test.cc"],
    deps = [
        ":status_coro_task",
        "@pigweed//pw_allocator:testing",
        "@pigweed//pw_async2:basic_dispatcher",
        "@pigweed//pw_async2:coro",
    ],
)
