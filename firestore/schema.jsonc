{
  // Cross-cutting fields: modifiedBy (string|null) and modifiedAt (timestamp)
  // are automatically added by the web mutation hook on all writable collections.
  //
  // Cross-collection links: every link between documents is stored as a
  // Firestore DocumentReference, never a plain string ID. The single
  // exception is `price_lists.items` (plain strings) — that field is read
  // back via Firestore's documentId() `in` query, which only accepts raw
  // document IDs. See docs/adr/0023-canonical-firestore-access.md.

  "price_lists": {
    "{priceListId}": {
      "name": "string",           // List title (e.g., "Holzwerkstatt Materialien")
      "items": ["string"],        // Catalog document IDs (plain strings, not DocumentReferences — needed for documentId() queries)
      "footer": "string",         // Footer text (e.g., "Offene Werkstatt Wädenswil – Holzwerkstatt")
      "active": "boolean",
      "generatedAt": "timestamp | null", // last PDF generation; compared to items' modifiedAt to flag "veraltet"
      "modifiedBy": "string | null",
      "modifiedAt": "timestamp"
    }
  },
  "catalog": {
    "{itemId}": { // 20-char Firestore-shaped ID. Pre-generated, committed in the seed JSON (scripts/seed-data/catalog.json).
      "code": "string", // Short numeric SKU for kiosk entry (e.g., "3002"); independent of the doc ID.
      "name": "string", // e.g., "Ahorn 30mm", "Sperrholz Pappel 3mm"
      // Curated label fields from Mario's pricelist (Etikett Name / Etikett Mass),
      // stored verbatim for the label printer; `name` is composed from them on
      // import. Absent on non-imported items.
      "labelName": "string | undefined",
      "labelMass": "string | undefined",
      "workshops": ["string"], // e.g., ["holz"], ["holz", "metall"]
      // Root-to-leaf category path. Free-form values, not pre-registered.
      // Queryable with `array-contains` at any depth (e.g.
      // `array-contains "Holzplatten"` matches both Sperrholz and MDF
      // children). The picker derives the chip tree from the categories
      // present among items in the current workshop scope.
      "category": ["string"], // e.g., ["Holzplatten", "Sperrholz"]
      "active": "boolean",
      "userCanAdd": "boolean", // true = users can add to checkout, false = system-only (NFC machine hours, memberships)
      "description": "string | null",

      // 1..n purchase options, each fully priced. `variants[0]` is canonical:
      // picker uses it silently when length == 1; auto-bill flows resolve
      // through it. Array order is meaningful — keep the default first. For
      // makerspace laser stock the extra entries are the cut-to-size options;
      // the importer expands them from the workbook `Varianten` sheet
      // (base × factor) at import time — nothing is derived at read time. The
      // Mitgliedschaft item uses variant ids "single" and "family" to
      // discriminate the two membership types (no separate `kind` field).
      "variants": [
        {
          "id": "string", // stable within the item: "default", "m2", "zuschnitt-a3", "single", "family"
          // Display label, e.g. "Per m²", "Zuschnitt A3", "Einzel (Jahr)".
          // Optional: omitted on single-variant items where the catalog
          // `name` already describes everything. Picker UI gates variant-
          // selector rendering on variants.length > 1.
          "label": "string | null | undefined",
          "pricingModel": "time | area | length | count | weight | direct | sla",
          // time → hours, area → m², length → meters, count → pieces, weight → kg,
          // direct → CHF, sla → resin (ml, priced per L via unitPrice) + layers
          // (count, priced via global config.pricing.slaLayerPrice)
          //
          // `default` is mandatory (un-discounted price). Member is an
          // optional override; if absent, default applies. Future tiers
          // (volunteer, child, …) can be added as additional optional
          // keys without touching items that don't need them.
          "unitPrice": { "default": "number", "member": "number | undefined" }
        }
      ]
    }
  },
  "machine": {
    "{machineId}" : {
      "name": "string", // Human readable label
      "workshop": "string", // Workshop ID (e.g., "holz", "metall")
      "checkoutTemplateId": "DocumentReference", // DocumentReference to /catalog/{itemId}
      "requiredPermission": ["DocumentReference"], // Array of DocumentReferences to /permission/{permissionId}
      "maco": "DocumentReference", // DocumentReference to /maco/{deviceID}
      // How the terminal controls the machine (mirrors the MachineControl
      // proto oneof; synced to the device by scripts/sync-device-config.ts).
      "control": {
        // "relay" (default): relay follows the session; billed on wall-clock
        //   session duration.
        // "gateway_sensing": relay stays on for the session, but the terminal
        //   leases a sensing session from the gateway, which runs the device
        //   protocol (e.g. the xTool laser's WebSocket) and reports running/idle
        //   — only active time (usage.activeSeconds) is billed and the session
        //   auto-ends when idle too long. See ADR-0035.
        "type": "string", // "relay" | "gateway_sensing"
        // gateway_sensing only:
        "kind": "string", // gateway backend, e.g. "xtool_laser"
        "host": "string", // device hostname/IP on the LAN
        "port": "number | undefined", // default per backend (xtool_laser: 28900)
        "pollIntervalSec": "number | undefined", // default 3
        "idleTimeoutSec": "number | undefined", // default 900 (15 min)
        "idleWarningSec": "number | undefined" // default 60 (1 min)
      },
      // Admin block. Absent/null = frei. Set/cleared on the admin machine
      // page ("Sperren" with a reason); terminals deny sessions while set.
      "blocked": {
        "kind": "problem | maintenance",
        "note": "string | null",
        "byName": "string | null",  // display name of the blocking admin
        "at": "timestamp"
      }
    }
  },
  "permission": {
    "{permissionId}": {
      "name": "string", // Human readable permission name (e.g., "Laser Cutter")
      "description": "string | null" // Optional description
    }
  },
  "authentications": {
    "{authId}": { // generated in AuthenticateTag
      "tokenId": "DocumentReference", // DocumentReference to /tokens/{tokenId}
      "keySlot": "number", // Which key was used (0-4)
      "created": "timestamp", // When the authentication was initiated

      // Crypto state for 3-pass mutual auth - set to null once auth completes successfully
      "inProgressAuth": {
        "rndA": "bytes", // Cloud-generated random (RndA)
        "rndB": "bytes"  // Tag's random after decryption (RndB)
      }, // | null

      // Firestore TTL field (auto-delete). Set to created + 5 min on
      // AuthenticateTag; cleared (set to null) on successful CompleteTagAuth
      // so completed records are retained. TTL policy declared in
      // firestore.indexes.json. Best-effort: GC may lag up to ~24 h.
      "ttlAt": "timestamp | null"
    }
  },
  "usage_machine": {
    "{usageId}": {
      "userId": "DocumentReference", // DocumentReference to /users/{userId}
      "authenticationId": "DocumentReference | null", // DocumentReference to /authentications/{authId}
      "machine": "DocumentReference", // DocumentReference to /machine/{machineId}
      "startTime": "timestamp", // session check-in (wall clock)
      "endTime": "timestamp", // session check-out (wall clock)
      "activeSeconds": "number", // in-use time reported by the terminal (laser cutting time); 0 for relay machines
      "billableSeconds": "number", // frozen billing basis: activeSeconds for gateway_sensing machines, else endTime-startTime. Summed by accumulation.
      "endReason": "string | null", // JSON representation of CheckOutReason proto
      "checkoutItemRef": "DocumentReference | null", // DocumentReference to /checkouts/{checkoutId}/items/{itemId}
      "notBilledReason": "string?", // "after_verified_payment": linked to the checkout but in no row's minutes or price — it arrived after a verified payment priced the checkout (BIL-42); never billed. The row may have been deleted at settlement.
      "workshop": "string" // Workshop ID (e.g., "holz") — denormalized from machine
    }
  },
  "checkouts": {
    // {checkoutId} doc IDs are Firestore auto-IDs (20-char).
    "{checkoutId}": {
      // --- Always present ---
      "userId": "DocumentReference", // DocumentReference to /users/{userId}; null for anonymous
      // "cancelled" (ADR-0042): an admin voided this closed visit. The doc
      // stays as the as-billed record; the corrected re-issue is a NEW
      // closed checkout linked via supersededByCheckoutRef. Legacy docs
      // lack the cancellation fields — never filter on `== null`.
      "status": "open | closed | cancelled",
      // The visit's usage type (issue #605, ADR-0050): derived by the close
      // from persons[].usageType — the owner's volunteering/intern, else
      // materialbezug when every person has it, else regular. Decides machine
      // time and material; each person's own type decides their usage fee.
      // materialbezug also marks a purchase-only checkout (CHK-9): nobody
      // works in the workshop — the server's badge/membership/renewal
      // checkouts (no persons) store it directly.
      // Checkouts closed before #605 carry only this one type
      // (readers: `person.usageType ?? checkout.usageType`).
      "usageType": "regular | ermaessigt | materialbezug | intern | hangenmoos | volunteering",
      "created": "timestamp",
      "workshopsVisited": ["string"], // e.g., ["holz", "metall"]
      "persons": [{ // Array of person entries
        "name": "string",
        "email": "string",
        "userType": "erwachsen | kind | firma",
        "billingAddress": { // Optional, for firma userType
          "company": "string",
          "street": "string",
          "zip": "string",
          "city": "string"
        },
        // Optional link to a known user account. Only ever the checkout
        // owner's own line (ADR-0048) — every other person is a guest by
        // name. Older checkouts may link a login-less family member (ADR-0029).
        "userRef": "DocumentReference | null",
        // Optional. True when this named person already paid the daily usage
        // fee on the same Zurich business day (boundary 03:00) via an earlier
        // closed checkout, so their entry fee is waived for this one
        // (issue #268). Derived at close-time from prior bills; only ever set
        // for persons carrying a userRef (anonymous/guest persons are always
        // charged).
        "entryFeeWaivedToday": "boolean (optional)",
        // Optional (issue #605). The person's own usage type, chosen on the
        // check-in; volunteering/intern only on the owner's line while alone.
        "usageType": "regular | ermaessigt | materialbezug | intern | hangenmoos | volunteering (optional)",
        // Optional (issue #605). users/{owner}/savedPersons/{id} the line was
        // added from; kept at close only if that doc exists. Keys the
        // same-day waiver for the saved person.
        "savedPersonId": "string (optional)"
      }],
      "modifiedBy": "string | null", // Firebase Auth UID
      "modifiedAt": "timestamp",

      // Firebase Auth UID of the user who created this checkout. Set to
      // `request.auth.uid` for every client-side create (anonymous OR
      // signed-in Firebase Auth). Null only for system / admin-SDK
      // writes. Stable across the
      // checkout's lifetime (unlike `modifiedBy`, which tracks the last
      // writer); the abandoned-checkout cleanup pairs an expired anon
      // auth user with the checkouts they created via this field. See
      // issue #318.
      "firebaseUid": "string | null",

      // --- Optional: set when a bill is created ---
      "billRef": "DocumentReference | null", // DocumentReference to /bills/{billId}

      // --- Only present when status == "closed" ---
      "closedAt": "timestamp",
      "notes": "string | null",
      "summary": {
        "totalPrice": "number",
        "entryFees": "number",
        "machineCost": "number",
        "materialCost": "number",
        "tip": "number"
      },

      // --- Customer's last-selected payment method on the Bezahlen step ---
      // Written fire-and-forget on every tab click, so the workshop has a
      // record of intent even if the user leaves without committing. The
      // commit-time ack itself lives on the bill (paymentMethodConfirmationTime
      // / paymentMethodConfirmationSource on /bills/{id}). Distinct from
      // /bills/{id}.paidVia, which is a server-stamped confirmation written
      // when the cash actually arrives. Ids name the integration, not the
      // brand (shared/src/payment-methods.ts, ADR-0044): "raisenow" is the
      // TWINT paylink.
      // "wallee_terminal" is server-only: written by settleTerminalPayment
      // when Wallee confirms the payment, never by a client (rules).
      "paymentMethod": "rechnung | monthly | raisenow | wallee_terminal | null",

      // --- Stale-open-checkout reminder log (#531) ---
      // One timestamp appended by the daily `staleCheckoutReminders` cron
      // each time it emails the account holder about a checkout left open
      // past the workshop business day. Server-only: firestore.rules denies
      // client writes so a user can't self-mute. The cron derives the next
      // due reminder purely from this array (length -> which configured
      // offset is next) + a one-per-business-day guard, so the cadence is
      // config-only (CHECKOUT_REMINDER_OFFSET_DAYS).
      "remindersSent": ["timestamp"],

      // --- Cancellation / corrected re-issue (ADR-0042). Server-only. ---
      // Set by the admin `correctCheckouts` callable. A cancelled checkout
      // keeps status "cancelled" and everything it had; the replacement is
      // a NEW closed checkout with `supersedesCheckoutRef` pointing back.
      "cancelledAt": "timestamp | null",
      "cancelledBy": "string | null",          // admin uid
      "cancellationReason": "string | null",
      "supersededByCheckoutRef": "DocumentReference | null",
      "supersedesCheckoutRef": "DocumentReference | null",
      // Explicit null on cancelled + replacement checkouts until the daily
      // stats export has flushed their rows (they sit behind the closedAt
      // watermark); absent on every other doc, so `== null` is a precise
      // "pending flush" query.
      "statsFlushedAt": "timestamp | null",

      // --- Payment terminal (ADR-0051). Server-only. ---
      // Attempts priced by prepareTerminalPayment while the checkout is
      // open, keyed by attempt number; each is the close it becomes once
      // Wallee confirms its payment (reference "{P|S}-{checkoutId}-{n}" is
      // the terminal's merchantReference). Deleted at close.
      "terminalAttempts": {
        "{attempt}": {
          "reference": "string",
          "amount": "number",                // CHF sent to the terminal
          "usageType": "string",
          "persons": "[CheckoutPerson]",     // the roster as it will be stored
          "summary": "CheckoutSummary",
          "items": "map<itemId, CheckoutItem>",      // the items as priced; settlement closes with these
          "machineUsageIds": "map<itemId, [string]>", // usage_machine ids each machine row held when priced
          "checkoutPersonsKey": "string",    // digest of the checkout's persons when priced (change alert)
          "preparedBy": "string",            // principal; modifiedBy on close
          "createdAt": "timestamp"
        }
      },
      "terminalAttemptCount": "number",      // last attempt number handed out
      "walleeTransactionId": "number | null", // the payment that closed it

      "items": {
        "{itemId}": { // Auto-generated — subcollection of checkouts/{checkoutId}
          "workshop": "string", // e.g., "holz"
          "description": "string", // Human-readable label (from catalog.name, optionally suffixed with variant label)
          "origin": "nfc | manual | qr",
          "catalogId": "DocumentReference | null", // DocumentReference to /catalog/{itemId}, null for free-form
          // Matches catalog.variants[i].id when catalogId is set. null for
          // ad-hoc origin="manual" / "qr" items that have no catalog link.
          "variantId": "string | null",
          "created": "timestamp",

          // Pricing & quantity
          "quantity": "number", // Amount in item's base unit (hours, m², meters, kg, pieces)
          "unitPrice": "number", // Snapshot from catalog.variants[i].unitPrice[discount]
          "totalPrice": "number", // quantity × unitPrice

          // Form state (for re-populating input fields)
          "formInputs": [{ // Optional array of user-entered values before conversion
            "quantity": "number",
            "unit": "string"
          }],
          "pricingModel": "string | null", // Snapshot from catalog.variants[i].pricingModel

          // Self-service badge purchase (server-written ONLY; rules deny
          // these fields on client item writes). The tapped badge's token id
          // rides on the line item until checkout close creates
          // tokens/{tokenId} for the checkout's user; badgeSdmCounter (the
          // purchase tap's SDM read counter) seeds lastSdmCounter there.
          "tokenId": "string?",
          "badgeSdmCounter": "number?"
        }
      }
    }
  },
  "config": {
    "pricing": {
      // Per-userType × usageType entry fee. entryFeeFor() throws if a row
      // is missing, so every userType × usageType combination must be set.
      "entryFees": {
        "erwachsen": { "regular": "number", "ermaessigt": "number", "materialbezug": "number", "intern": "number", "hangenmoos": "number" },
        "kind": { "regular": "number", "ermaessigt": "number", "materialbezug": "number", "intern": "number", "hangenmoos": "number" },
        "firma": { "regular": "number", "ermaessigt": "number", "materialbezug": "number", "intern": "number", "hangenmoos": "number" }
      },
      // SLA resin prints: per-layer CHF cost (constant across all resin types,
      // hardware-wear-driven) by discount level. Per-liter resin price lives
      // on each catalog entry's unitPrice.
      "slaLayerPrice": { "none": "number", "member": "number" },
      "workshops": {
        "{workshopId}": { // e.g., "holz", "metall", "makerspace"
          "label": "string", // Display name (e.g., "Holzwerkstatt")
          "order": "number" // Sort order
        }
      },
      "labels": {
        "units": {}, // Map of unit key to display label (e.g., "m2": "m²", "h": "Std.")
        "discounts": {} // Map of discount level to display label (e.g., "none": "Kein Rabatt")
      }
    },
    // Production-code lookup table for catalog items the runtime needs to
    // find by purpose rather than by doc ID. Lets ops rebind a reference
    // (e.g. roll a new membership SKU with a price change) without a code
    // deploy.
    "billing": {
      // Sequential counter read + incremented by allocateBill inside the
      // bill-minting transaction (ADR-0019). Stored bill numbers are
      // counter × 10 + revision digit (ADR-0042): the counter is never
      // multiplied itself.
      "nextBillNumber": "number",
      // Written once by scripts/migrate-bill-numbers.ts. allocateBill refuses
      // to mint against an existing doc without it; a missing doc (fresh
      // install) bootstraps with it set.
      "referenceNumberFormat": "shifted-v1"
    },
    "catalog-references": {

      "membership": "DocumentReference", // DocumentReference to the Mitgliedschaft catalog item (variants: "single", "family")
      "badge": "DocumentReference" // DocumentReference to the NFC-Badge catalog item (variants: "standard", "gratis")
    }
  },
  "audit_log": {
    "{logId}": {
      "collection": "string", // Collection name being audited
      "docId": "string", // Document ID in that collection
      "operation": "create | update | delete",
      "actorUid": "string | null", // Firebase Auth UID of actor
      "before": "object | null", // Serialized document before change
      "after": "object | null", // Serialized document after change
      "timestamp": "timestamp"
    }
  },
  "bills": {
    "{billId}": {
      "userId": "DocumentReference",       // DocumentReference to /users/{userId}
      "checkouts": ["DocumentReference"],   // Array of DocumentReferences to /checkouts/{id}
      "referenceNumber": "number",          // Sequential bill number (e.g., 42); SCOR reference computed at render time
      "amount": "number",                   // Total CHF
      "currency": "string",                 // "CHF"
      "storagePath": "string | null",       // "invoices/{billId}.pdf"
      "created": "timestamp",
      "paidAt": "timestamp | null",
      "paidVia": "raisenow | ebanking | free | wallee_terminal | null",
      "pdfGeneratedAt": "timestamp | null", // optimistic lock for PDF generation
      "emailSentAt": "timestamp | null",    // optimistic lock for email sending
      // Set once by trySendEmail when the bill has nobody to mail (no
      // account-holder e-mail, no guest e-mail — #651) so the hourly retry
      // stops re-trying and re-logging. Absent on legacy docs (= not
      // skipped). Clear it manually to re-arm the send, e.g. after an
      // admin adds an e-mail to a login-less account.
      "emailSkippedReason": "no-recipient | null",
      // The "I'll pay this" ack. Server-only, written when the bill is
      // minted — by the close (source: "user"), a Wallee-confirmed terminal
      // payment ("terminal", bill born paid) or the server itself ("auto":
      // CHF 0, monthly Sammelrechnung, renewal, correction; before #757
      // also the overnight job). Null only on a legacy bill nobody
      // committed. The email and membership-activation triggers key off a
      // bill born committed, or off this transitioning from null to set.
      "paymentMethodConfirmationTime": "timestamp | null",
      "paymentMethodConfirmationSource": "user | auto | terminal | null",
      // Terminal payments only (ADR-0051), server-only: the Wallee
      // transaction id and Wallee's cardholder receipt text (masked card
      // number, auth code), printed on the Quittung.
      "walleeTransactionId": "number | null",
      "walleeReceiptText": "string | null",
      // The committed payment method (ADR-0052): null until committed and
      // for a CHF 0 bill. What the bill does follows from its
      // PAYMENT_METHOD_INFO properties — an aggregated method ("monthly")
      // makes it a Beleg for the Sammelrechnung, collected by
      // monthlyBillRun on the 1st. A Sammelrechnung itself is "rechnung".
      "paymentMethod": "rechnung | monthly | raisenow | wallee_terminal | null",
      // What the customer holds (ADR-0052): prefix (BL- for a Beleg, else
      // RE-), title and file name. Set at mint, fixed at commit. A Beleg
      // asks for no payment itself — for the Sammelrechnung, paid during
      // the checkout on the customer's word (RaiseNow TWINT) or CHF 0; a
      // Quittung confirms a verified payment (Wallee terminal) — and is
      // what a RaiseNow bill issued before #763 stays (BIL-46). Never key
      // the Sammelrechnung on "beleg".
      "document": "rechnung | sammelrechnung | beleg | quittung",
      // Legacy queue marker: "beleg" = for the Sammelrechnung. Written in
      // step with paymentMethod until every environment is backfilled
      // (scripts/backfill-bill-document.ts); bills without the two fields
      // above are read through the @oww/shared resolvers' fallback.
      "kind": "invoice | beleg",
      // Set on a Beleg for the Sammelrechnung once monthlyBillRun has
      // folded it into a Sammelrechnung. Re-runs skip Belege where this
      // is set — provides the cron's idempotency guarantee.
      "aggregatedIntoBillRef": "DocumentReference | null",
      // Origin discriminator (issue #323). "checkout" = a normal Self-
      // Checkout visit bill (the default — missing value is treated as
      // "checkout" so legacy docs migrate-free). "membership-renewal" =
      // a bill the daily renewalInvoicer cron auto-issued for an
      // expiring membership (no in-person checkout). Surfaces on bill
      // PDFs / admin views and is the marker the renewal cron uses.
      "source": "checkout | membership-renewal",
      // --- Cancellation / corrected re-issue (ADR-0042). Server-only. ---
      // referenceNumber is stored as base × 10 + revision digit (0 =
      // original, 1 = first correction …); the formatters render
      // "RE-4200001" / "RE-4200001-1" from 42000010 / 42000011. A cancelled
      // bill stays in place; its replacement keeps the base number.
      "cancelledAt": "timestamp | null",
      "cancelledBy": "string | null",          // admin uid
      "cancellationReason": "string | null",
      "supersededByBillRef": "DocumentReference | null",
      "supersedesBillRef": "DocumentReference | null",
      "correctionReason": "string | null",
      // Sammelrechnung revision only: replacement Belege of the same commit,
      // attached to the revision's correction mail.
      "correctedBillRefs": "[DocumentReference] | null",
      "cancellationNoticeSentAt": "timestamp | null", // optimistic lock, pure cancellations
      "modifiedBy": "string | null",
      "modifiedAt": "timestamp | null"
    }
  },

  "erasures": {
    // Server-only, PII-free erasure receipts (ADR-0038). Doc id = the
    // erased subject's uid, or HMAC(email) for email-only walk-ins.
    // Retained indefinitely as proof of erasure; re-running an erasure is
    // idempotent via the phase marker, and re-running a completed one
    // re-executes only the audit purge (async-trigger race fix).
    "{subjectId}": {
      "subjectKind": "registered | walk-in",
      "startedAt": "timestamp",
      "completedAt": "timestamp",           // absent until phase == done
      "actorUid": "string",                 // admin who ran the erasure
      "phase": "flush | delete | auth | audit | done",
      "counts": "map<string, number>",      // docs deleted/redacted per collection
      "auditPurgePaths": ["string"],        // collection/docId of audited docs to purge
      "auditPurged": "number",
      "lastPurgeRunAt": "timestamp"
    }
  },
  "export_state": {
    // Server-only per-stream watermarks for the daily BigQuery stats export
    // (ADR-0039). One doc per stream: visits, machine_usage, bills,
    // membership_snapshots. Advanced only after a successful sink insert;
    // the trim/erasure engines read these to guard unexported docs.
    "{stream}": {
      "watermark": "timestamp",             // age-basis of the last exported doc
      "lastDocId": "string",                // cursor tiebreak (startAfter pair)
      "updatedAt": "timestamp"
    }
  },
  "operations_log": {
    // Reusable error/warning log for async operations on any entity
    "{logId}": {
      "collection": "string",               // source collection, e.g. "bills"
      "docId": "string",                    // source document ID
      "operation": "string",                // e.g. "pdf_generate", "email_send"
      "severity": "error | warning | info",   // info: DSAR accountability entries (ADR-0038)
      "message": "string",
      "timestamp": "timestamp"
    }
  },
  "machine_reports": {
    "{reportId}": {
      // User-submitted machine issue reports ("Meldungen"; public create,
      // admin read/update/delete). Triaged on the admin machine page.
      "machine": "DocumentReference",   // /machine/{machineId}
      "message": "string",
      "userId": "DocumentReference | null",  // /users/{userId} when signed in
      "reporterName": "string | null",  // free-text fallback for kiosk reports
      "created": "timestamp",
      "status": "open | done",
      "resolvedAt": "timestamp | null"
    }
  },
  "maco": {
    "{deviceId}": { //  particle device id (e.g., "0a10aced202194944a042f04")
      "name": "string", // Human readable terminal name (e.g., "Dev Terminal 01")
      "hwRevision": "string | null", // Hardware revision from Particle device info
      "status": {
        // Device status (ADR-0045, phase 2c) — written only by the functions
        // from the gateway's reports, admin-readable, NOT audited. The same
        // document shape lives under gateways/{gatewayId}/status/current
        // (+ "terminals") and kiosks/{kioskId}/status/current; the parents
        // have no documents of their own.
        "current": {
          "kind": "maco | gateways | kiosks", // repeats the path (collection-group reads)
          "deviceId": "string",            // repeats the path
          "version": "string | null",      // release version, e.g. "2026.10.3"
          "online": "boolean",
          "since": "timestamp",            // when online last flipped
          "bootedAt": "timestamp | null",  // derived from uptime; changes on reboot
          "resetReason": "string | null",  // unknown | watchdog | panic | power_cycle | ota_update | user_requested
          "bootCount": "number | null",    // consecutive incomplete boots (ADR-0040)
          "firstSeen": "timestamp",
          "lastSeen": "timestamp",         // last heard (terminal: last ping); refreshed at most hourly while online
          "rebootWrittenAt": "timestamp | null",
          "gatewayId": "string",           // terminals: the reporting gateway
          "terminals": "string[]"          // gateways: terminal ids last reported online
        }
      }
    }
  },
  "tokens": {
    "{tokenId}": { // NTag UID (e.g., "04c339aa1e1890")
      "userId": "DocumentReference", // DocumentReference to /users/{userId}
      "registered": "timestamp", // time the token was added to the user's profile
      "deactivated": "timestamp", // optional timestamp, when set the token is not in use anymore
      "label": "string", // Token label (e.g., "Key 1")
      "lastSdmCounter": "number" // Last observed SDM read counter (24-bit). Updated atomically by verifyTagCheckout for replay defense; treated as 0 when absent.
    }
  },
  "loginCodes": {
    "{id}": { // id is a 32-byte random base64url string — also the magic-link token
      "email": "string",            // normalized lowercase
      "codeHash": "string",         // sha256(`${code}|${id}`)
      "expiresAt": "timestamp",     // created + 5 min; also the Firestore TTL field (auto-delete)
      "created": "timestamp",
      "attempts": "number",         // verification attempts used; doc burned after 5
      "consumedAt": "timestamp | null", // set on successful verify or when invalidated
      "debugCode?": "string"        // EMULATOR ONLY — plaintext code for E2E tests; absent in production docs
    }
  },
  "terminalPaymentAlerts": {
    // Server-only (Admin SDK; no client rules). One marker per Wallee
    // transaction and alert outcome (ADR-0051), so the webhook's retries and
    // the nightly reconcile — which sees each payment for three days —
    // raise an alert like terminal_double_charge once, not every night.
    // Auto-deleted via the `expiresAt` TTL policy.
    "{transactionId}_{outcome}": {
      "transactionId": "number",   // Wallee transaction id
      "outcome": "unmatched | amount-mismatch | checkout-changed | double-charge | voided",
      "reference": "string | null", // the transaction's merchantReference ({P|S}-{checkoutId}-{n} for ours)
      "createdAt": "timestamp",
      "expiresAt": "timestamp"     // created + 7 days (past the reconcile window); Firestore TTL field
    }
  },
  "printJobs": {
    // Label print jobs. The admin web app renders the label and builds the
    // Brother raster bytes client-side, then writes a `queued` job here. The
    // on-LAN gateway (maco_gateway) watches for queued jobs via a Firestore
    // service account, sends the bytes to the printer, and writes the
    // terminal status (+ German error) back, which the admin UI awaits.
    // Rules: admins create `queued` + read status; the gateway SA bypasses
    // rules for status writes. Auto-deleted via the `ttlAt` TTL policy.
    "{id}": {
      "bytesB64": "string",          // base64 Brother raster job (buildRasterJob output)
      "tape": "string",              // tape width used, e.g. "18mm" (informational)
      "status": "queued | printing | done | error",
      "error": "string | null",      // German printer error (parseStatus) when status == error
      "createdBy": "string",         // Firebase Auth UID of the enqueuing admin
      "createdAt": "timestamp",
      "ttlAt": "timestamp"           // created + ~1h; Firestore TTL field (auto-delete)
    }
  },
  "users": {
    "{userId}": { // Doc ID = Firebase Auth UID. Legacy login-less family members
                   // (ADR-0029, no longer created — ADR-0048) have a credential-less
                   // auth user and email null.
      "created": "timestamp",
      // Login e-mail, normalized (trim + lowercase). Canonical identity —
      // Firebase Auth follows it (ADR-0043). No client can set or change it,
      // admins included (rules pin it to the session's token e-mail on create,
      // to the prior value on update); admins change it via `updateUserEmail`.
      "email": "string | null",       // null for legacy login-less family members
      // Contact number, E.164. The Auth-linked SMS-login number must be null
      // or equal to this — a mismatch unlinks it until re-verified (ADR-0043).
      "phone": "string | null",
      "firstName": "string", // First name (e.g., "Michael")
      "lastName": "string", // Last name (e.g., "Schneider")
      "permissions": ["DocumentReference"], // Array of DocumentReferences to /permission/{permissionId}
      "roles": ["admin"], // "vereinsmitglied" is no longer a role — membership is its own entity
      "termsAcceptedAt": "timestamp | null", // When user accepted terms of service
      "userType": "erwachsen | kind | firma", // User type for pricing

      // When the kiosk "so nutzt du dein Konto" instructions email was last
      // sent (issue #595) — throttles re-sends to once an hour. Absent on
      // accounts that never triggered one.
      "accountInstructionsSentAt": "timestamp",

      // Denormalized pointer to the user's single active membership.
      //   null  → not a member (pricing falls back to "none")
      //   !null → member (server still re-validates `validUntil > now`)
      // Maintained by the onMembershipWritten trigger and the daily expiry job.
      "activeMembership": "DocumentReference | null",

      "billingAddress": { // Required when userType == "firma" (Rechnungsadresse)
        "company": "string", // Company name (required)
        "street": "string",
        "zip": "string",
        "city": "string"
      }, // | null

      // Companions the account holder saved on a check-in (issue #605,
      // ADR-0050). Create + delete only (no update); the owner (login or
      // kiosk badge session acting on them) reads/creates/deletes, admins
      // read. Deleted with the account by the privacy engine; not trimmed.
      // The usage type is never saved.
      "savedPersons": {
        "{savedPersonId}": { // Auto-generated
          "firstName": "string",
          "lastName": "string",
          "userType": "erwachsen | kind",
          "createdAt": "timestamp",
          "modifiedBy": "string | null",
          "modifiedAt": "timestamp"
        }
      }
    }
  },
  "memberships": {
    "{membershipId}": { // Auto-generated Firebase ID
      "type": "single | family",
      "status": "active | expired | cancelled",

      // Period tracking
      // When the bill that added the current year was committed — despite the
      // name not when it was paid; payments are only booked on the bill (BIL-34).
      "lastPaidAt": "timestamp | null",
      "validUntil": "timestamp",        // Expiration (= lastPaidAt + 1 year, or extended)

      // Members
      "ownerUserId": "DocumentReference",     // /users/{userId} — pays, manages roster, receives reminders
      "members": ["DocumentReference"],        // /users/{userId}[] — all current members (includes owner)
                                              // length === 1 for "single"; >= 1 for "family"

      // Audit trail of payments — references into /checkouts/{id} that paid for this membership.
      // Source of truth for "when/how much/which method" is the checkout itself.
      "paymentCheckouts": ["DocumentReference"],

      // Annual auto-renewal (issue #323). When true (the default for new
      // and backfilled memberships), the daily renewalInvoicer cron
      // auto-issues a QR-Rechnung ~30 days before validUntil. The member
      // cancels auto-renewal via the cancelMembershipAutoRenew callable
      // (account page or admin) — that sets this to false; the membership
      // still stays active until validUntil. Missing value is treated as
      // true so legacy docs renew until explicitly cancelled.
      "autoRenew": "boolean",
      // Set to the open renewal bill ref while a renewal invoice is
      // outstanding; the cron skips memberships where this is non-null so
      // it never double-invoices. Cleared back to null when that bill is
      // paid (membership extended) — see applyMembershipPayment.
      "pendingRenewalBill": "DocumentReference | null",

      "notes": "string | null", // Admin notes only

      "modifiedBy": "string | null",
      "modifiedAt": "timestamp",
      "created": "timestamp",
      "createdBy": "string | null",

      "invites": {
        "{inviteId}": { // Auto-generated — only used for type == "family"
          "email": "string",                        // normalized lowercase
          "status": "pending | accepted | rejected | revoked",
          "invitedAt": "timestamp",
          "invitedBy": "DocumentReference",         // /users/{userId}
          "resolvedAt": "timestamp | null",
          "resolvedUserId": "DocumentReference | null", // /users/{userId} on accept

          // Firestore TTL field — auto-delete pending/rejected/revoked invites after 30 days.
          // TTL policy declared in firestore.indexes.json. Best-effort: GC may lag up to ~24h.
          "ttlAt": "timestamp"
        }
      }
    }
  }
}
